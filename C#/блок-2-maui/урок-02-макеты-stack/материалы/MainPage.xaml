<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="HeroCard.MainPage" BackgroundColor="#EEF2F7">
 <ScrollView>
  <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Fill">
   <Label Text="Гильдия искателей" FontSize="28" FontAttributes="Bold" TextColor="#17243A" />
   <Border x:Name="HeroBorder" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="2" Padding="16">
    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
    <VerticalStackLayout x:Name="HeroLayout" Spacing="14">
     <HorizontalStackLayout Spacing="12">
      <Image Source="hero.png" WidthRequest="84" HeightRequest="84" Aspect="AspectFit" />
      <VerticalStackLayout Spacing="4" VerticalOptions="Center">
       <Label Text="Лира" FontSize="24" FontAttributes="Bold" TextColor="#17243A" />
       <Label Text="Следопыт" TextColor="#475569" />
      </VerticalStackLayout>
     </HorizontalStackLayout>
     <HorizontalStackLayout Spacing="10">
      <Label Text="Уровень:" TextColor="#475569" />
      <Label Text="7" FontAttributes="Bold" TextColor="#17243A" />
     </HorizontalStackLayout>
     <Label x:Name="StatusLabel" Text="Готова к походу" TextColor="#166534" />
     <VerticalStackLayout x:Name="DetailsPanel" Spacing="6" IsVisible="False">
      <Label Text="Оружие: лук" TextColor="#17243A" />
      <Label Text="Навык: разведка" TextColor="#17243A" />
     </VerticalStackLayout>
     <Button x:Name="DetailsButton" Text="Показать навыки" Clicked="OnDetailsClicked" BackgroundColor="#315B9B" TextColor="White" />
    </VerticalStackLayout>
   </Border>
   <Button Text="Сменить оформление" Clicked="OnThemeClicked" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>